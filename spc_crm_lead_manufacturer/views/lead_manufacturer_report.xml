                                <th colwidth="20" easyfx="font: bold on; align: horiz center; border: bottom medium">Invoice Date</th>
                                <th colwidth="20" easyfx="font: bold on; align: horiz center; border: bottom medium">Due Date</th>
                                <th easyfx="font: bold on; align: horiz center; border: bottom medium">Balance</th>
