<?xml version="1.0" encoding="utf-8"?>

<openerp>
    <data>
        <template id="report_lead_manufacturer">
            <div class="workbook">
                <div class="worksheet" name="Reporte del comercial" fixpages="1" wpages="1" hpages="0">
                    <table>
                        <tbody>
                            <tr>
                                <td colspan="11" rowspan="3" easyfx="font: bold on, height 400; align: horiz center,vert center">Reporte del comercial</td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-set="row_count" t-value="5"/>
                    <t t-set="row_start" t-value="5"/>
                    <t t-if="'user_id' in data">
                        <t t-set="row_count" t-value="7"/>
                        <t t-set="row_start" t-value="7"/>
                        <table>
                            <tbody>
                                <tr>
                                    <td>Comercial:</td>
                                    <td><span t-esc="get_user(data['user_id']).name"/></td>
                                </tr>
                                <tr><td></td></tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-foreach="data['leads']" t-as="leadstruct">
                        <table>
                            <thead>
                                <t t-if="'user_id' not in data">
                                    <tr><th></th></tr>
                                </t>
                                <tr>
                                    <th easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;"><span t-esc="leadstruct[1]"/> - <span t-esc="leadstruct[0]"/></th>
                                </tr>
                                <tr>
                                    <th colwidth="35" easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Company</th>
                                    <th colwidth="30" easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Opportunity</th>
                                    <th colwidth="6" easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">ID</th>
                                    <th easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Deadline</th>
                                    <t t-if="not 'user_id' in data">
                                        <th colwidth="20" easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Salesman</th>
                                    </t>
                                    <th colwidth="15" easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Principal Address</th>
                                    <th easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">State/Status</th>
                                    <th easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Commited</th>
                                    <th easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Expected</th>
                                    <th easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Sold</th>
                                    <th easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">None</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_leads(leadstruct[2])" t-as="lead">
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;"><span t-field="lead.company_id"/></td>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;"><span t-field="lead.name"/></td>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;"><span t-field="lead.id"/></td>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;"><span t-field="lead.date_deadline"/></td>
                                    <t t-if="not 'user_id' in data">
                                        <td easyfx="borders: bottom thin, top thin, left thin, right thin;"><span t-field="lead.user_id"/></td>
                                    </t>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;"><span t-field="lead.principal_address"/></td>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;"><span t-field="lead.stage_id"/></td>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00"><t t-if="lead.projection == 'committed'"><span t-esc="lead.x_planned_margin"/></t></td>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00"><t t-if="lead.projection == 'expected'"><span t-esc="lead.x_planned_margin"/></t></td>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00"><t t-if="lead.projection == 'sold'"><span t-esc="lead.x_planned_margin"/></t></td>
                                    <td easyfx="borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00"><t t-if="lead.projection == 'none'"><span t-esc="lead.x_planned_margin"/></t></td>
                                    <t t-set="row_count" t-value="row_count+1"/>
                                </tr>
                                <t t-if="'user_id' in data">
                                    <tr>
                                        <td colspan="5"></td>
                                        <td easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Total</td>
                                        <td formula="1" easyfx="font: bold on; align: horiz center; borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00">SUM(G<t t-esc="row_start+1" />:G<t t-esc="row_count" />)</td>
                                        <td formula="1" easyfx="font: bold on; align: horiz center; borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00">SUM(H<t t-esc="row_start+1" />:H<t t-esc="row_count" />)</td>
                                        <td formula="1" easyfx="font: bold on; align: horiz center; borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00">SUM(I<t t-esc="row_start+1" />:I<t t-esc="row_count" />)</td>
                                        <td formula="1" easyfx="font: bold on; align: horiz center; borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00">SUM(J<t t-esc="row_start+1" />:J<t t-esc="row_count" />)</td>
                                        <td></td>
                                    </tr>
                                </t>
                                <t t-if="not 'user_id' in data">
                                    <tr>
                                        <td colspan="6"></td>
                                        <td easyfx="font: bold on;borders: bottom medium, top medium, left medium, right medium;">Total</td>
                                        <td formula="1" easyfx="font: bold on; align: horiz center; borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00">SUM(H<t t-esc="row_start+1" />:H<t t-esc="row_count" />)</td>
                                        <td formula="1" easyfx="font: bold on; align: horiz center; borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00">SUM(I<t t-esc="row_start+1" />:I<t t-esc="row_count" />)</td>
                                        <td formula="1" easyfx="font: bold on; align: horiz center; borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00">SUM(J<t t-esc="row_start+1" />:J<t t-esc="row_count" />)</td>
                                        <td formula="1" easyfx="font: bold on; align: horiz center; borders: bottom thin, top thin, left thin, right thin;" num_format_str="[$$-409]#,##0.00;[RED]-[$$-409]#,##0.00">SUM(K<t t-esc="row_start+1" />:K<t t-esc="row_count" />)</td>
                                        <td></td>
                                    </tr>
                                </t>
                                <t t-set="row_start" t-value="row_count+4"/>
                                <t t-set="row_count" t-value="row_count+4"/>
                                <tr><td></td></tr>
                            </tbody>
                        </table>
                    </t>
                    <!-- table>
                        <thead>
                            <tr>
                                <th easyfx="font: bold on; align: horiz center; border: bottom medium">Number</th>
