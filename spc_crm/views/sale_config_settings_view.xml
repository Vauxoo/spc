<openerp>
    <data>
        <record id="view_sale_config_form" model="ir.ui.view">
            <field name="name">Sale Config Form</field>
            <field name="model">sale.config.settings</field>
            <field name="inherit_id" ref="base_setup.view_sale_config_settings"/>
            <field name="priority" eval="16"/>
            <field name="arch" type="xml">
                <xpath expr="//form/div[@name='customer feature']" position="inside">
                    <separator string="BC Sync Configuration"/>
                    <group name="bc_sync">
                        <label for="id" string="BC Sync Authorization Code"/>
                        <div name="bc_sync">
                            <div name="bc_sync_auth_code">
                                <field name="spc_crm_bc_authorization_code"  class="oe_inline"/>
                            </div>
                            <div name="bc_sync_auth_uri">
                                <field name="spc_crm_bc_uri" widget="url" text="Generate Google Authorization Code" class="oe_inline oe_bold"/>
                            </div>
                        </div>
                        <label for="id" string="BC Template"/>
                        <div name="bc_sync_template">
                            <div name="bc_sync_template">
                                <field name="spc_crm_bc_template"  class="oe_inline"/>
                            </div>
                        </div>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</openerp>