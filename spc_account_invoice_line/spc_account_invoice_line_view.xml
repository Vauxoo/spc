<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
        <!-- views -->
        <!-- accoun.invoice -->
        <record id="account_invoice_form2" model="ir.ui.view">
            <field name="name">Account Invoice Form</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form" />
            <field name="priority" eval="50" />
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/notebook/page[@string='Invoice Lines']" position="after">
                    <page name="print_lines" string="Print Lines">
                        <field name="print_line_ids">
                            <tree editable="bottom">
                                <field name="quantity" />
                                <field name="name"/>
                                <field name="discount" />
                                <field name="invoice_line_tax_id" />
                                <field name="price_unit"/>
                                <field name="price_subtotal"/>
                            </tree>
                            
                        </field>
                    </page>
                    
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@string='Invoice Lines']/group[1]" position="replace">
                    
                </xpath>
                <xpath expr="//form/sheet/notebook" position="after">
                    <group class="oe_subtotal_footer oe_right" col="3" >
                        <span></span>
                        <span><b>Print Lines</b></span>
                        <span><b>Real Lines</b></span>
                        <field name="subtotal_print" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_untaxed_not_discounted" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_tax_print" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_tax" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="discount_print" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_discounted" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="total_print" class="oe_subtotal_footer_separator"  groups="account.group_account_user" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator"  groups="account.group_account_user" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <label for ="residual"/>
                        <span > 0.0</span>
                        <field name="residual" nolabel="1" groups="account.group_account_user" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <button name="button_copy_amounts" states="draft,proforma2"
                                        string="(copy)" class="oe_link oe_edit_only"
                                        type="object" help="Recompute amounts of print lines"/>
                    </group>
                     <div class="oe_clear">
                        <label string=" "/>
                    </div>
                </xpath>
            </field>
        </record>
 

        <!-- For the report -->
        <record id="account_invoice_report_inherit" model="ir.ui.view">
            <field name="name">Account Invoice Report Inherit</field>
            <field name="inherit_id" ref="account_invoice_report.account_invoice_report"/>
            <field name="priority" eval="150" />
            <field name="type">qweb</field>
            <field name="arch" type="xml">
            <xpath expr="//t/t/div/table[@class='table table-condensed mt8 mb0']/tbody/tr[@t-foreach='o.invoice_line']" position="replace">
                <tr t-foreach="o.print_line_ids" t-as="l">
                    <td style="white-space: nowrap">
                        <span t-esc="'{:,.16g}'.format(l.quantity)"/>
                        <span t-field="l.uos_id" groups="product.group_uom"/>
                    </td>
                    <td>
                        <span t-field="l.name"/>
                    </td>
                    <td style="white-space: nowrap">
                        <t t-if="l.invoice_line_tax_id">
                            <span t-field="l.invoice_line_tax_id"/>
                        </t>
                        <t t-if="not l.invoice_line_tax_id">
                            XMT
                        </t>
                    </td>
                    <td class="text-right" style="white-space: nowrap">
                        <span t-field="l.price_unit" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                    </td>
                    <td class="text-right" t-if="o.amount_discounted != 0.0"><span t-field="l.discount"/>%</td>
                    <td class="text-right" style="white-space: nowrap">
                        <span t-field="l.price_subtotal" t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}"/>
                    </td>
                </tr>
            </xpath>
            <xpath expr="//t/t/div/div[@class='row']/div[@class='col-xs-4']/table[@class='table table-condensed mt0']" position="replace">
                <table class="table table-condensed mt0"
                    style="width: auto; float: right; page-break-inside:avoid">
                    <tr class="border-black text-right" style="white-space: nowrap">
                        <td t-att-colspan="(o.discount_print != 0.0) and '5' or '4'"
                            style="padding-left: 24px; padding-right: 15px">
                            <b>Subtotal</b>
                        </td>
                        <td>
                            <b>
                                <span t-field="o.subtotal_print"
                                    t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}" />
                            </b>
                        </td>
                    </tr>
                    <tr t-if="o.discount_print != 0.0" class="text-right"
                        style="white-space: nowrap; border: none">
                        <td colspan="5" style="padding-left: 24px; padding-right: 15px">
                            Discount (
                            <span t-field="o.discount_print" />
                            %)
                        </td>
                        <td>
                            <span t-field="o.discount_print"
                                t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}" />
                        </td>
                    </tr>
                    <t t-if="o.amount_tax_print != 0.0">
                        <tr class="text-right" style="white-space: nowrap; border: none"
                            t-foreach="o.tax_line" t-as="t">
                            <td t-att-colspan="(o.discount_print != 0.0) and '5' or '4'"
                                style="padding-left: 24px; padding-right: 15px">
                                <span t-field="t.name" />
                            </td>
                            <td>
                                <span t-field="t.amount_tax_print"
                                    t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}" />
                            </td>
                        </tr>
                    </t>
                    <t t-if="o.amount_tax_print == 0.0">
                        <tr class="text-right" style="white-space: nowrap; border: none">
                            <td t-att-colspan="(o.discount_print != 0.0) and '5' or '4'"
                                style="padding-left: 24px; padding-right: 15px">
                                Taxes
                            </td>
                            <td>
                                <span t-field="o.amount_tax_print"
                                    t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}" />
                            </td>
                        </tr>
                    </t>
                    <tr class="text-right" style="white-space: nowrap; font-size: 120%">
                        <td t-att-colspan="(o.discount_print != 0.0) and '5' or '4'"
                            style="padding-left: 24px; padding-right: 15px; border-top: 1px solid black">
                            <b>Total</b>
                        </td>
                        <td style="border-top: 1px solid black">
                            <b>
                                <span t-field="o.total_print"
                                    t-field-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: &quot;o.currency_id&quot;}" />
                            </b>
                        </td>
                    </tr>
                </table>
            </xpath> 
            </field>
        </record>
    </data>
</openerp>